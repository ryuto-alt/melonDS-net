#define VOS_NT_WINDOWS32    0x00040004L
#define VFT_APP                      0x00000001L

//this will set your .exe icon
100 ICON MOVEABLE PURE LOADONCALL DISCARDABLE "${CMAKE_SOURCE_DIR}/res/ryue.ico"

//include version information in .exe, modify these values to match your needs
1 VERSIONINFO
FILEVERSION ${MELON_RC_VERSION}
PRODUCTVERSION ${MELON_RC_VERSION}
FILETYPE VFT_APP
{
  BLOCK "StringFileInfo"
	{
		BLOCK "040904E4"
		{
			VALUE "CompanyName", "RyuE"
			VALUE "FileVersion", "${melonDS_VERSION}"
			VALUE "FileDescription", "RyuE emulator"
			VALUE "InternalName", "RyuE"
			VALUE "LegalCopyright", "Based on melonDS, 2016-2025 melonDS team"
			VALUE "LegalTrademarks", ""
			VALUE "OriginalFilename", "melonDS.exe"
			VALUE "ProductName", "RyuE"
			VALUE "ProductVersion", "${melonDS_VERSION}"
		}
	}
  BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 1252 //language codes
	}
}

#if (0${MINGW})
1 24 "xp.manifest"
#endif
